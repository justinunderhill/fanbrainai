NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Fixture/result sync (football-data.org free tier covers WC 2026)
FOOTBALL_API_PROVIDER=football-data
# Get a free token at https://www.football-data.org/client/register
# Sent server-side as the X-Auth-Token header. Never expose to the client.
FOOTBALL_DATA_API_TOKEN=
# Shared secret guarding /api/admin/sync-fixtures and score-final-matches.
# Set the same value in Vercel so Vercel Cron can authenticate (Bearer).
CRON_SECRET=
# Legacy/alternative provider (unused while on football-data)
SPORTMONKS_API_TOKEN=

# Web push (personal result notifications). Generate a keypair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Public key is inlined into the client bundle; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI sent to push services (defaults to mailto:hello@fanbrainai.com)
VAPID_SUBJECT=mailto:hello@fanbrainai.com
