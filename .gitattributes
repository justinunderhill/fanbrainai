# Normalize line endings to LF in the repo; check out as-is on each platform.
# Stops the CRLF/LF churn between Windows dev and Vercel/Linux builds.
* text=auto eol=lf

# Binary assets should never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
